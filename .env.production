# ===================================================
# 生产环境配置 (Production / Google Cloud Run)
# ===================================================

# 运行环境
NODE_ENV=production
APP_ENV=production

# 服务端口 (Cloud Run 会自动注入 PORT 环境变量，默认 8080)
PORT=8080

# 消息持久化驱动开关: firestore (云端全托管数据库) | file (本地单机挂载)
STORAGE_DRIVER=firestore

# GCP Firestore 集合名
FIRESTORE_COLLECTION=messages

# 生产环境跨域配置 (建议配置具体的域名，或保持 * 兼容多端访问)
CORS_ORIGIN=*

# 日志输出级别 (生产环境过滤调试噪音)
LOG_LEVEL=info

# Socket.IO 心跳配置
SOCKET_PING_INTERVAL=25000
SOCKET_PING_TIMEOUT=60000
