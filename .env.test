# ===================================================
# 测试/CI 演练环境配置 (Test / Ephemeral)
# ===================================================

NODE_ENV=test
APP_ENV=test
PORT=8081

# 测试驱动采用纯内存存储，测试后自动回收，不留磁盘脏数据
STORAGE_DRIVER=memory

CORS_ORIGIN=*
LOG_LEVEL=warn
SOCKET_PING_INTERVAL=10000
SOCKET_PING_TIMEOUT=20000
