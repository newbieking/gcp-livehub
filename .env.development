# ===================================================
# 开发环境配置 (Development)
# ===================================================

# 运行环境: development | production | test
NODE_ENV=development
APP_ENV=development

# 服务端口
PORT=8080

# 消息持久化驱动开关: file (本地文件) | memory (纯内存) | firestore (云端数据库)
STORAGE_DRIVER=file

# 跨域配置: * 或 http://localhost:3000
CORS_ORIGIN=*

# 日志输出级别: debug | info | warn | error
LOG_LEVEL=debug

# Socket.IO 心跳配置 (毫秒)
SOCKET_PING_INTERVAL=25000
SOCKET_PING_TIMEOUT=60000
