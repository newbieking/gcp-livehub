{
  "name": "gcloud",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file=.env.development --watch src/index.js",
    "start:prod": "node --env-file=.env.production src/index.js",
    "test:contrast": "node scripts/check-contrast.js",
    "test:auth": "node scripts/test-auth.js && node scripts/test-auth-api.js",
    "test": "node --env-file=.env.test src/index.js",
    "env:dev": "node scripts/switch-env.js dev",
    "env:prod": "node scripts/switch-env.js prod",
    "env:test": "node scripts/switch-env.js test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "express": "^5.3.0",
    "socket.io": "^4.8.4"
  }
}
